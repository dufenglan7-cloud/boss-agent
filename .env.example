# Export these variables in your shell; this file is a reference, not loaded automatically.
BOSS_AGENT_API_KEY=
BOSS_AGENT_BASE_URL=https://api.openai.com/v1
BOSS_AGENT_MODEL=

# SQLite location for the FastAPI service (relative to its working directory)
BOSS_AGENT_DB_PATH=data/boss-agent.sqlite3

# Langfuse monitoring (optional; configure before starting the service)
BOSS_AGENT_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Set the URL of your own Langfuse project region or self-hosted instance.
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENVIRONMENT=development
# false = structure/status/timing/token usage only; true also sends redacted content.
BOSS_AGENT_LANGFUSE_CAPTURE_CONTENT=false
